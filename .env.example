# Translation engine
# API mode: "ollama" (/api/chat) or "openai" (/v1/chat/completions — vLLM, local Ollama, llama.cpp, etc.)
LLM_API_MODE=ollama
TARGET_LANGUAGE=English
# Optional for local / vLLM / Colab; required for Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
# Examples: https://ollama.com | http://host.docker.internal:11434 | http://host.docker.internal:8001
OLLAMA_HOST=https://ollama.com
# Optional local caps per key (0 = none; a 429 pauses that key for a minute)
OLLAMA_RPM_LIMIT=0
OLLAMA_RPD_LIMIT=0
# Chapters of a series translated in parallel
TRANSLATION_CONCURRENCY=3

# Optional: Managed Google Colab GPU sessions (configure & connect in Web Settings -> Google Colab)
COLAB_ENABLED=false
COLAB_GPU=L4
COLAB_HIGH_MEM=false
COLAB_ENGINE=vllm
COLAB_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
COLAB_EXTRA_ARGS=--max-model-len 16384 --gpu-memory-utilization 0.9
COLAB_HF_TOKEN=
COLAB_AUTO_START=true
COLAB_AUTO_STOP=true
COLAB_IDLE_STOP_MINUTES=0
COLAB_SESSION_NAME=fableport
COLAB_LOCAL_PORT=8001

PIXIV_REFRESH_TOKEN=
FANFICTL_OUTPUT_DIR=./output
APP_DOMAIN=example.com
APP_BASE_URL=https://example.com
# Optional: leave empty and one is generated and stored in the data folder
APP_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
HOST=0.0.0.0
PORT=8000
